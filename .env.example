# --- Database ---
# Owner/superuser role: DDL, migrations, bootstrap only.
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev_password
POSTGRES_DB=aegis
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Least-privilege runtime role that all request traffic uses (RLS applies to it).
APP_DB_USER=aegis_app
APP_DB_PASSWORD=aegis_app_password

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Application ---
# Generate a real secret for production: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- Seed (first-run bootstrap org + admin) ---
# On an empty database the first organisation and its admin are created from the
# SEED_ORG_* / SEED_ADMIN_* values below (SEED_BOOTSTRAP=true, the default). Change the
# admin password on first login.
# SEED_DATA adds the DEMO sample data (sample risks, controls, approvals, a second
# "isolation demo" org). Keep it false for every client installation; set it to true
# only for local development or a demo host.
SEED_DATA=false
SEED_BOOTSTRAP=true
SEED_ORG_NAME=Acme Corp
SEED_ORG_SLUG=acme
SEED_ADMIN_EMAIL=admin@acme.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Frontend ---
# Browser-facing origin of THIS deployment, incl. scheme + port. nginx serves the
# app and proxies /api on the same origin, so this is just the external URL users
# hit. Baked into the web bundle at BUILD time — rebuild `web` after changing it
# (docker compose -f docker-compose.prod.yml up -d --build web).
# Prod example on a shared host using a custom port: https://18.142.228.92:8443
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Host ports (dev compose only) ---
# The dev stack publishes the API and the web app directly (no nginx). Change
# these when the defaults are already taken on a shared box — the symptom is
# "bind: address already in use" on startup. NEXT_PUBLIC_API_BASE_URL above must
# then point at the same API_PORT, and the web image must be rebuilt.
API_PORT=8080
WEB_PORT=3000

# --- Reverse-proxy host ports (prod compose) ---
# nginx publishes these on the host. Leave at 80/443 for a dedicated host; change
# them when those ports are already in use (e.g. another app on the same box).
# Only open the port you actually use in the cloud firewall / AWS Security Group.
HTTP_PORT=80
HTTPS_PORT=443

# --- Authentication hardening (banking baseline) ---
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_COMPLEXITY=true
PASSWORD_EXPIRY_DAYS=0
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# MFA (decision 3, PCI DSS 8.4.2 / ISO 27001 A.8.5). MFA_ENFORCEMENT is the level every
# organisation starts at:
#   everyone   - everyone who signs in with a password (local or LDAP/AD) must enrol, with
#                MFA_GRACE_DAYS to do so. The production default.
#   privileged - only the Admin role, anyone who can approve, and MFA_REQUIRED_ROLES (or the
#                list an organisation sets under Settings -> Organisation -> Security).
#   off        - nobody is made to enrol. People who enrolled keep using it. For evaluation
#                and client UAT installs only; never for a production bank.
# SSO users are exempt at every level: the identity provider owns their second factor. An
# organisation's administrator can pick a different level for their organisation unless
# MFA_ENFORCEMENT_LOCKED=true (set it where the bank's IT security policy owns the decision).
# MFA_REQUIRED is the older switch (true = everyone) and is only read when MFA_ENFORCEMENT
# is unset.
MFA_ENFORCEMENT=everyone
MFA_ENFORCEMENT_LOCKED=false
MFA_REQUIRED=true
MFA_REQUIRED_ROLES=admin
MFA_GRACE_DAYS=7
MFA_ISSUER=NexusLine GRC
LDAP_ENABLED=false
# Public self-service sign-up (POST /auth/register-org). Keep false on every client
# installation; operators create organisations from Settings -> Organisations, within the
# licence's organisation cap (1 for an on-premise bank).
ALLOW_SELF_REGISTRATION=false
ENFORCE_SEGREGATION_OF_DUTIES=true

# --- Outbound email (SMTP). Leave SMTP_HOST empty to log instead of send. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NexusLine GRC <no-reply@nexusline.local>
SMTP_USE_TLS=true
APP_BASE_URL=http://localhost:3000

# --- Background scheduler (reminders / chasing / digests) ---
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=15

# --- File storage (binary uploads) ---
FILE_STORAGE_DIR=/data/uploads
MAX_UPLOAD_MB=25

# --- On-prem productionization ---
APP_VERSION=1.0.0
DEPLOYMENT_MODE=on-prem
BACKUP_DIR=/data/backups
# Offline licensing (Ed25519, no phone-home). Only the file location is settable
# here: whether the license is enforced, and which key validates it, are compiled
# into the image (backend/app/core/build.py), so there is nothing to switch off
# at runtime.
LICENSE_FILE=./deploy/license.key

# BUILD-time only, and only meaningful when building the prod compose from
# source. Leave unset (defaults to true) for anything a client runs. Set to
# false for instances we host ourselves, which want the prod hardening but have
# no license to check — otherwise the build fails demanding a vendor key.
# PRODUCTION_BUILD=false

# --- Deciding approvals from e-mail (Approve / Reject links) ---
# Links skip two-factor authentication (the link itself is the credential), so they are
# off by default: no links are sent, digests show no Approve / Reject buttons, and links
# already sent stop working. Set true only where policy accepts deciding from e-mail.
EMAIL_ACTIONS_ENABLED=false
